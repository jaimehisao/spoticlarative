# Spotify API Credentials
# Register your application at https://developer.spotify.com/dashboard/applications
# and add a Redirect URI (e.g., http://localhost:8888/callback or any other)
SPOTIPY_CLIENT_ID="your_spotify_client_id_here"
SPOTIPY_CLIENT_SECRET="your_spotify_client_secret_here"
SPOTIPY_REDIRECT_URI="your_spotify_redirect_uri_here"

# Git Repository for Storing Playlists
# This is the remote Git URL where the playlist data will be cloned from and pushed to.
# Example: https://github.com/your_username/your_playlist_repo.git
REMOTE="your_git_remote_url_for_playlists_here"
